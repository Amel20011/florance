# GEMINI_API_KEY / AI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY="MY_AI_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BuatQris Payment Gateway credentials
BUATQRIS_BASE_URL="https://api.buatqris.site"
BUATQRIS_ACCOUNT_ID="your_account_id"
BUATQRIS_SECRET_TOKEN="your_secret_token"

# Resend Email Delivery for OTP Verification
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FLORANCE <onboarding@resend.dev>"
EMAIL_FROM="FLORANCE <onboarding@resend.dev>"
SESSION_SECRET=""
OTP_SECRET=""
OTP_EXPIRES_IN_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
